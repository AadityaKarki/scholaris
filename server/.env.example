# Copy this file to server/.env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (the cluster needs an Atlas Vector Search index; see atlas-vector-index.json)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Google AI Studio API key, used for Gemini embeddings and answers
GOOGLE_API_KEY=

# Firebase project ID, used to verify users' sign-in tokens (Firebase console > Project settings)
FIREBASE_PROJECT_ID=

# Optional
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=embedding-001
VECTOR_INDEX_NAME=vector_index
MAX_UPLOAD_MB=20
